#!/usr/bin/env python3
from __future__ import annotations

import argparse
from collections import Counter
import json
import os
import re
import subprocess
from dataclasses import dataclass
from pathlib import Path


GITHUB_TOKEN = re.compile(r"(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})")
HOME_PATH = re.compile(r"(?:/Users|/home)/[A-Za-z0-9._-]+")
EMAIL = re.compile(r"[A-Za-z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}")
EXAMPLE_EMAIL_DOMAINS = {"example.com", "example.net", "example.org"}
IDENTITY_ALLOWLIST = "review-allowlist.txt"
INFRASTRUCTURE_ROOTS = {"docs", "scripts", "tests"}
PRIVATE_NETWORK = re.compile(
    r"\b(?:10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|"
    r"172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})\b"
)
DEVICE_IDENTIFIER = re.compile(r"\b(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}\b")
PRIVATE_HOST = re.compile(
    r"(?:https?://|ssh://|\b(?:host|hostname)\s*[:=]\s*[\"']?)"
    r"[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.(?:internal|lan|local)\b",
    re.IGNORECASE,
)
HARDCODED_CREDENTIAL = re.compile(
    r"(?i)\b(?:password|passwd|secret|token|api[_-]?key|private[_-]?key)\b"
    r"\s*[:=]\s*[\"']?([A-Za-z0-9_./+=-]{12,})"
)
PLACEHOLDER_WORDS = ("example", "placeholder", "changeme", "replace-me")
PRIVATE_KEY = re.compile(r"-----BEGIN (?:[A-Z0-9]+ )?PRIVATE KEY-----")
PORTABLE_TARGET = re.compile(r"`[^`]*(?:/|\\)[^`]*`")
PREREQUISITE_GUIDANCE = re.compile(
    r"(?i)\b(?:prerequisites?|required|requires|needs?|dependenc(?:y|ies)|must be installed)\b"
)
VALIDATION_GUIDANCE = re.compile(r"(?i)\b(?:validate|validation|check|test)\b")


@dataclass(frozen=True)
class Finding:
    rule: str
    path: str
    line: int
    message: str

    def __str__(self) -> str:
        return f"BLOCKING [{self.rule}] {self.path}:{self.line} {self.message}"


def git_paths(root: Path, *arguments: str) -> list[str]:
    result = subprocess.run(
        ["git", *arguments],
        cwd=root,
        check=True,
        capture_output=True,
    )
    return [path.decode("utf-8") for path in result.stdout.split(b"\0") if path]


def repository_content(root: Path, mode: str) -> list[tuple[str, bytes]]:
    if mode == "staged":
        changed_paths = git_paths(
            root,
            "diff",
            "--cached",
            "--name-only",
            "--diff-filter=ACMRD",
            "-z",
        )
        paths = (
            git_paths(root, "ls-files", "-z")
            if IDENTITY_ALLOWLIST in changed_paths
            else git_paths(
                root,
                "diff",
                "--cached",
                "--name-only",
                "--diff-filter=ACMR",
                "-z",
            )
        )
        return [
            (
                path,
                b"" if is_local_state(path) or is_backup_path(path) else index_content(root, path),
            )
            for path in paths
        ]

    tracked_paths = set(git_paths(root, "ls-files", "-z"))
    paths = git_paths(root, "ls-files", "--cached", "--others", "--exclude-standard", "-z")
    contents: list[tuple[str, bytes]] = []
    for path in paths:
        if is_local_state(path):
            contents.append((path, b""))
        elif is_backup_path(path):
            if path in tracked_paths:
                contents.append((path, b""))
        else:
            content = safe_worktree_bytes(root, path)
            if content is not None:
                contents.append((path, content))
    return contents


def safe_worktree_bytes(root: Path, path: str) -> bytes | None:
    current = root
    parts = Path(path).parts
    for index, part in enumerate(parts):
        current = current / part
        if current.is_symlink():
            return os.readlink(current).encode("utf-8") if index == len(parts) - 1 else None
    return current.read_bytes() if current.is_file() else None


def is_local_state(path: str) -> bool:
    return path == ".local" or path.startswith(".local/")


def is_backup_path(path: str) -> bool:
    name = Path(path).name
    parts = Path(path).parts
    return (
        name.endswith(("~", ".bak", ".backup"))
        or "backups" in parts
        or ".backup" in parts
    )


def index_content(root: Path, path: str) -> bytes:
    return subprocess.run(
        ["git", "show", f":{path}"],
        cwd=root,
        check=True,
        capture_output=True,
    ).stdout


def repository_paths(root: Path, mode: str) -> list[str]:
    if mode == "staged":
        return git_paths(root, "ls-files", "-z")
    return git_paths(root, "ls-files", "--cached", "--others", "--exclude-standard", "-z")


def repository_text(root: Path, mode: str, path: str) -> str | None:
    if mode == "staged":
        result = subprocess.run(
            ["git", "show", f":{path}"],
            cwd=root,
            check=False,
            capture_output=True,
        )
        content = result.stdout if result.returncode == 0 else None
    else:
        content = safe_worktree_bytes(root, path)
    if content is None:
        return None
    try:
        return content.decode("utf-8")
    except UnicodeDecodeError:
        return None


def application_modules(paths: list[str]) -> set[str]:
    return {
        Path(path).parts[0]
        for path in paths
        if len(Path(path).parts) > 1
        and not Path(path).parts[0].startswith(".")
        and Path(path).parts[0] not in INFRASTRUCTURE_ROOTS
    }


def module_contract_findings(root: Path, mode: str) -> list[Finding]:
    paths = repository_paths(root, mode)
    modules = application_modules(paths)
    findings: list[Finding] = []
    for module in sorted(modules):
        readme_path = f"{module}/README.md"
        readme = repository_text(root, mode, readme_path)
        if readme is None:
            findings.append(Finding(
                "module.english-readme",
                readme_path,
                1,
                "Application Module must provide a normative English README.md.",
            ))
            readme = ""
        if not PORTABLE_TARGET.search(readme):
            findings.append(Finding(
                "module.target-guidance",
                readme_path,
                1,
                "Module guidance must state the real, portable target configuration location.",
            ))
        if not PREREQUISITE_GUIDANCE.search(readme):
            findings.append(Finding(
                "module.prerequisite-guidance",
                readme_path,
                1,
                "Module guidance must explain required prerequisites or dependencies.",
            ))
        if not VALIDATION_GUIDANCE.search(readme):
            findings.append(Finding(
                "module.validation-guidance",
                readme_path,
                1,
                "Module guidance must explain a safe validation method.",
            ))
        for path in paths:
            if not path.startswith(f"{module}/README.") or path == readme_path:
                continue
            translation = (repository_text(root, mode, path) or "").casefold()
            if not all(term in translation for term in ("english", "normative", "readme.md")):
                findings.append(Finding(
                    "module.translation-source",
                    path,
                    1,
                    "Translation must link to README.md and state that the English README is normative.",
                ))
    findings.extend(change_information_findings(root, mode, modules))
    return findings


def change_information_findings(
    root: Path,
    mode: str,
    modules: set[str],
) -> list[Finding]:
    if mode == "staged":
        prior = "HEAD"
        changed = git_paths(
            root,
            "diff",
            "--cached",
            "--name-only",
            "--diff-filter=ACMRD",
            "-z",
        )
        current_changelog = repository_text(root, mode, "CHANGELOG.md") or ""
    else:
        base = subprocess.run(
            ["git", "rev-parse", "--verify", "origin/main^{commit}"],
            cwd=root,
            text=True,
            capture_output=True,
            check=False,
        )
        head = subprocess.run(
            ["git", "rev-parse", "--verify", "HEAD^{commit}"],
            cwd=root,
            capture_output=True,
            check=False,
        )
        if head.returncode:
            return []
        prior = "origin/main" if base.returncode == 0 else "HEAD"
        committed = (
            git_paths(
                root,
                "diff",
                "--no-ext-diff",
                "--no-textconv",
                "--name-only",
                "--diff-filter=ACMRD",
                "-z",
                "origin/main...HEAD",
            )
            if base.returncode == 0
            else []
        )
        worktree = git_paths(
            root,
            "diff",
            "--no-ext-diff",
            "--no-textconv",
            "--name-only",
            "--diff-filter=ACMRD",
            "-z",
            "HEAD",
        )
        untracked = git_paths(root, "ls-files", "--others", "--exclude-standard", "-z")
        changed = sorted(set(committed + worktree + untracked))
        current_changelog = repository_text(root, mode, "CHANGELOG.md") or ""

    prior_result = subprocess.run(
        ["git", "show", f"{prior}:CHANGELOG.md"],
        cwd=root,
        text=True,
        capture_output=True,
        check=False,
    )
    prior_changelog = prior_result.stdout if prior_result.returncode == 0 else ""

    def unreleased_lines(changelog: str) -> list[str]:
        in_unreleased = False
        lines: list[str] = []
        for line in changelog.splitlines():
            if line.strip() == "## [Unreleased]":
                in_unreleased = True
                continue
            if in_unreleased and line.startswith("## "):
                break
            if in_unreleased:
                lines.append(line)
        return lines

    new_unreleased = Counter(unreleased_lines(current_changelog)) - Counter(
        unreleased_lines(prior_changelog)
    )
    changed_roots = {
        Path(path).parts[0]
        for path in changed
        if len(Path(path).parts) > 1
        and not Path(path).parts[0].startswith(".")
        and Path(path).parts[0] not in INFRASTRUCTURE_ROOTS
    }
    prior_modules = {
        candidate
        for candidate in changed_roots
        if subprocess.run(
            ["git", "cat-file", "-e", f"{prior}:{candidate}/README.md"],
            cwd=root,
            check=False,
            capture_output=True,
        ).returncode
        == 0
    }
    findings: list[Finding] = []
    for module in sorted(modules | prior_modules):
        module_changes = [path for path in changed if path.startswith(f"{module}/")]
        if not module_changes:
            continue
        entry = re.compile(
            rf"^- \*\*{re.escape(module)} / [^*]+\*\*: .+",
            re.IGNORECASE,
        )
        if not any(
            count > 0 and entry.fullmatch(line)
            for line, count in new_unreleased.items()
        ):
            findings.append(Finding(
                "module.change-information",
                module_changes[0],
                1,
                f"User-affecting {module} changes require a categorized [Unreleased] entry.",
            ))
    return findings


def is_application_configuration(root: Path, mode: str, path: str) -> bool:
    parts = Path(path).parts
    if (
        len(parts) < 2
        or parts[0].startswith(".")
        or parts[0] in INFRASTRUCTURE_ROOTS
    ):
        return False
    return True


def approved_identities(
    root: Path,
    mode: str,
    contents: list[tuple[str, bytes]],
) -> tuple[set[str], list[Finding]]:
    allowlist = next((content for path, content in contents if path == IDENTITY_ALLOWLIST), None)
    if allowlist is None and mode == "staged":
        result = subprocess.run(
            ["git", "show", f":{IDENTITY_ALLOWLIST}"],
            cwd=root,
            check=False,
            capture_output=True,
        )
        allowlist = result.stdout if result.returncode == 0 else b""
    elif allowlist is None:
        allowlist = b""
    identities: set[str] = set()
    findings: list[Finding] = []
    for line_number, line in enumerate(allowlist.decode("utf-8").splitlines(), start=1):
        if not line or line.startswith("#"):
            continue
        identity, separator, reason = line.partition("\t")
        if not separator or not identity.strip() or not reason.strip():
            findings.append(Finding(
                "policy.identity-allowlist",
                IDENTITY_ALLOWLIST,
                line_number,
                "Identity exception must contain a literal value, a tab, and a reviewable reason.",
            ))
            continue
        identities.add(identity)
    return identities, findings


def main() -> int:
    parser = argparse.ArgumentParser(description="Check repository configuration safety")
    parser.add_argument("mode", choices=("all", "staged"))
    parser.add_argument("--root", type=Path, default=Path.cwd())
    arguments = parser.parse_args()

    contents = repository_content(arguments.root, arguments.mode)
    allowlisted_identities, findings = approved_identities(
        arguments.root,
        arguments.mode,
        contents,
    )
    findings.extend(module_contract_findings(arguments.root, arguments.mode))
    for relative_path, content in contents:
        if is_local_state(relative_path):
            findings.append(Finding(
                "policy.local-consumer-state",
                relative_path,
                1,
                "Local consumer state must remain ignored and untracked.",
            ))
            continue
        if is_backup_path(relative_path):
            findings.append(Finding(
                "policy.tracked-backup",
                relative_path,
                1,
                "Backup files must remain ignored and untracked.",
            ))
            continue
        try:
            text = content.decode("utf-8")
        except UnicodeDecodeError:
            continue
        if Path(relative_path).suffix == ".json" and is_application_configuration(
            arguments.root,
            arguments.mode,
            relative_path,
        ):
            try:
                json.loads(text)
            except json.JSONDecodeError as error:
                findings.append(Finding(
                    "syntax.json",
                    relative_path,
                    error.lineno,
                    f"Invalid JSON configuration: {error.msg}.",
                ))
        lines = text.splitlines()
        for line_number, line in enumerate(lines, start=1):
            if GITHUB_TOKEN.search(line):
                findings.append(Finding(
                    "secret.github-token",
                    relative_path,
                    line_number,
                    "GitHub token-like value must be removed and rotated.",
                ))
            if PRIVATE_KEY.search(line):
                findings.append(Finding(
                    "secret.private-key",
                    relative_path,
                    line_number,
                    "Private key material must be removed and rotated.",
                ))
            credential_match = HARDCODED_CREDENTIAL.search(line)
            if credential_match and not any(
                word in credential_match.group(1).lower() for word in PLACEHOLDER_WORDS
            ):
                findings.append(Finding(
                    "secret.hardcoded-credential",
                    relative_path,
                    line_number,
                    "Credential-like assignment must use an environment reference or placeholder.",
                ))
            if HOME_PATH.search(line):
                findings.append(Finding(
                    "privacy.home-path",
                    relative_path,
                    line_number,
                    "Personal home path must use a portable placeholder.",
                ))
            for email_match in EMAIL.finditer(line):
                email = email_match.group(0)
                domain = email.rsplit("@", maxsplit=1)[1].lower()
                if domain not in EXAMPLE_EMAIL_DOMAINS and email not in allowlisted_identities:
                    findings.append(Finding(
                        "privacy.email",
                        relative_path,
                        line_number,
                        "Email address must use a reserved example domain or an approved identity exception.",
                    ))
            if PRIVATE_NETWORK.search(line):
                findings.append(Finding(
                    "privacy.private-network",
                    relative_path,
                    line_number,
                    "Private network address must be replaced with a documented placeholder.",
                ))
            if DEVICE_IDENTIFIER.search(line):
                findings.append(Finding(
                    "privacy.device-identifier",
                    relative_path,
                    line_number,
                    "Device identifier must be removed or replaced with a placeholder.",
                ))
            if PRIVATE_HOST.search(line):
                findings.append(Finding(
                    "privacy.private-host",
                    relative_path,
                    line_number,
                    "Private hostname must be replaced with a documented placeholder.",
                ))

    if findings:
        print("\n".join(str(finding) for finding in findings))
        return 1
    print("Repository check passed.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
