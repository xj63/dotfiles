// Repository reference: merge this JSONC content into Zed's settings.json;
// do not copy the .jsonc filename into the user configuration directory.
// Official guide: https://zed.dev/docs/configuring-zed
{
  // Maintainer Preference: CLI and OS file-open requests create a new window
  // instead of reusing the default existing window. File > Open is unaffected.
  "cli_default_open_behavior": "new_window",

  // Maintainer Preferences: ask before Cmd-Q closes every workspace, and make
  // an already-focused panel shortcut close that panel. These change Zed's
  // immediate-quit and focus-only toggle defaults; quit confirmation can
  // interrupt scripted exits, and repeated panel shortcuts now hide the panel.
  "confirm_quit": true,
  "close_panel_on_toggle": true,

  // Maintainer Preference: show the Git panel as a hierarchical tree rather
  // than its flat default. Dock locations are omitted because Zed's right-side
  // defaults already match the desired layout.
  "git_panel": {
    "tree_view": true,
  },

  // Maintainer Preferences: the Catppuccin Icons extension provides the icon
  // name, the separate Catppuccin Blur extension provides both theme names, and
  // GitHub Next's Monaspace Frozen Fonts package provides the exact font family.
  // Verify each resource before selecting it; none is installed by this file.
  // https://zed.dev/extensions/catppuccin-icons
  // https://zed.dev/extensions/catppuccin-blur
  // https://github.com/githubnext/monaspace/releases
  // The default system mode still selects between the light and dark choices.
  "icon_theme": "Catppuccin Mocha",
  "theme": {
    "light": "Catppuccin Latte (Blur)",
    "dark": "Catppuccin Mocha (Blur)",
  },
  "buffer_font_family": "Monaspace Neon Frozen",

  // Maintainer Preferences: use smart-case search, keep the current code scope
  // visible, and retain six context lines around keyboard navigation. These
  // differ from fixed case-insensitive search, disabled editor sticky scroll,
  // and a three-line margin. Sticky headers and the larger margin consume
  // vertical space, especially in short panes.
  "use_smartcase_search": true,
  "sticky_scroll": {
    "enabled": true,
  },
  "vertical_scroll_margin": 6,

  // Maintainer Preferences: modal editing, wrapped relative numbers, automatic
  // save when focus leaves a buffer, and visible code intelligence. Focus-change
  // saves can trigger formatters/hooks; hints require language-server support.
  "vim_mode": true,
  "relative_line_numbers": "wrapped",
  "autosave": "on_focus_change",
  "minimap": {
    "show": "auto",
  },
  "inlay_hints": {
    "enabled": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "auto_signature_help": true,

  // Maintainer Preference: treat Objective-C and Objective-C++ extensions as
  // C++. Preserve a user's language-specific associations when they differ.
  "file_types": {
    "C++": ["mm", "m"],
  },

  // Maintainer Preference: visually wrap Markdown at the editor width without
  // inserting line breaks or changing code-file wrapping. This overrides the
  // global no-wrap default only for Markdown and may hide very long source lines.
  // https://zed.dev/docs/configuring-languages
  "languages": {
    "Markdown": {
      "soft_wrap": "editor_width",
    },
  },

  // Maintainer Preference for the optional third-party CargoTom extension:
  // suppress its documentation notice. The gallery confirms the server name,
  // but this initialization option is extension-version-specific; verify it
  // against the installed extension rather than Zed core defaults.
  // https://zed.dev/extensions/cargo-tom
  "lsp": {
    "cargo-tom": {
      "initialization_options": {
        "hide_docs_info_message": true,
      },
    },
  },

  // Maintainer Preference: opt out of Zed's default diagnostic and metrics
  // telemetry. Third-party extensions may have independent telemetry controls.
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
